{
  "name": "md2chat",
  "version": "0.5.0",
  "private": true,
  "description": "Markdown to editable chat messages — desktop and web",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check assets/chat-targets.js && npm run seo:check && node --check desktop/integration.cjs && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/payload.cjs && node --check assets/chat-clipboard.js && node --check assets/app.js && node --check assets/code-images.js && node --check assets/renderers.js && node --check assets/chat-markdown.js && npm test",
    "build": "node scripts/build.cjs",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --mac dir --arm64",
    "desktop:dist": "electron-builder --mac dmg zip --arm64 --publish never",
    "desktop:test": "electron desktop/smoke.cjs",
    "desktop:dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "desktop:dist:win": "electron-builder --win nsis --x64 --publish never",
    "seo:generate": "node scripts/seo.cjs --write",
    "seo:check": "node scripts/seo.cjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "author": "md2chat contributors",
  "build": {
    "appId": "io.github.forgeturl.md2chat",
    "productName": "md2chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/*.cjs",
      "editor.html",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "desktop/icon.icns",
      "desktop/icon.ico"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "desktop/icon.icns"
    },
    "artifactName": "md2chat-${os}-${arch}.${ext}",
    "dmg": {
      "title": "md2chat ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "md2chat-windows-${arch}-setup.${ext}"
    }
  }
}
