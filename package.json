{
  "name": "md2chat",
  "version": "0.6.22",
  "private": true,
  "description": "Markdown to editable chat messages — desktop and web",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs && npm run seo:check && npm test",
    "build": "node scripts/build.cjs",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:verify": "node scripts/release.cjs verify",
    "desktop": "node scripts/native.cjs tauri dev",
    "desktop:pack": "node scripts/pack-desktop.cjs",
    "desktop:dist": "node scripts/build-desktop-release.cjs mac universal",
    "predesktop:test": "node scripts/build-desktop.cjs",
    "desktop:test": "node scripts/native.cjs cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "predesktop:test:feishu": "node scripts/build-desktop.cjs",
    "desktop:test:feishu": "node scripts/native.cjs cargo test --locked --manifest-path src-tauri/Cargo.toml feishu",
    "predesktop:test:native": "node scripts/build-desktop.cjs",
    "desktop:test:native": "node scripts/native.cjs cargo test --locked --manifest-path src-tauri/Cargo.toml --lib clipboard::tests::native_roundtrip -- --ignored --test-threads=1",
    "predesktop:test:windows": "node scripts/build-desktop.cjs",
    "desktop:test:windows": "node scripts/native.cjs cargo test --locked --manifest-path src-tauri/Cargo.toml --lib clipboard::tests::native_roundtrip -- --ignored --test-threads=1",
    "desktop:dist:mac": "node scripts/build-desktop-release.cjs mac universal",
    "desktop:dist:win": "node scripts/build-desktop-release.cjs win x64",
    "seo:generate": "node scripts/seo.cjs --write",
    "seo:check": "node scripts/seo.cjs",
    "tauri": "node scripts/native.cjs tauri",
    "predesktop:check": "node scripts/build-desktop.cjs",
    "desktop:check": "node scripts/native.cjs cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:test:render": "node scripts/test-desktop-render.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "js-yaml": "4.3.2"
  },
  "author": "md2chat contributors",
  "build": {
    "publish": {
      "provider": "github",
      "owner": "forgeturl",
      "repo": "md2chat"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forgeturl/md2chat.git"
  }
}
